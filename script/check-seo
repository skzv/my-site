#!/usr/bin/env ruby
require 'nokogiri'
require 'json'
require 'open3'
require 'yaml'

root = ARGV.fetch(0, '_site')
locales = YAML.load_file('_data/locales.yml')
i18n = YAML.load_file('_data/i18n.yml')

def check(value, message)
  abort message unless value
end

expected_sitemap = ['/red/'].map { |p| "https://skz.dev#{p}" }

locales.each do |loc|
  code = loc.fetch('code')
  prefix = loc.fetch('prefix')
  tag = loc.fetch('tag')
  og_locale = loc.fetch('og')
  t = i18n.fetch(code)
  canonical = "https://skz.dev#{prefix}"
  expected_sitemap << canonical

  rel_path = prefix == '/' ? 'index.html' : File.join(prefix.delete_prefix('/'), 'index.html')
  full_path = File.join(root, rel_path)
  check(File.exist?(full_path), "#{code}: missing #{rel_path}")

  html = File.read(full_path)
  doc = Nokogiri::HTML(html)

  check(doc.at_css('html')['lang'] == tag, "#{code}: expected html[lang=#{tag}]")
  check(doc.css('title').size == 1, "#{code}: expected one title")
  check(doc.at_css('title').text == t.fetch('page_title'), "#{code}: unexpected title #{doc.at_css('title').text.inspect}")

  %w[description og:title og:description og:url og:type og:locale og:image og:image:type og:image:width og:image:height og:image:alt twitter:card twitter:description twitter:image twitter:image:alt].each do |key|
    nodes = doc.css("meta[name='#{key}'], meta[property='#{key}']")
    check(nodes.size == 1 && !nodes.first['content'].empty?, "#{code}: missing or duplicate #{key}")
  end

  check(doc.at_css("meta[property='og:locale']")['content'] == og_locale, "#{code}: wrong og:locale")
  alt_og = doc.css("meta[property='og:locale:alternate']").map { |n| n['content'] }.sort
  expected_alt_og = locales.reject { |l| l['code'] == code }.map { |l| l['og'] }.sort
  check(alt_og == expected_alt_og, "#{code}: unexpected og:locale:alternate")

  check(doc.css('link[rel=canonical]').size == 1 && doc.at_css('link[rel=canonical]')['href'] == canonical, "#{code}: invalid canonical")
  check(doc.at_css("meta[property='og:url']")['content'] == canonical, "#{code}: og:url differs from canonical")

  hreflangs = doc.css('link[rel=alternate][hreflang]').to_h { |n| [n['hreflang'], n['href']] }
  expected_hreflangs = locales.to_h { |l| [l['tag'], "https://skz.dev#{l['prefix']}"] }.merge('x-default' => 'https://skz.dev/')
  check(hreflangs == expected_hreflangs, "#{code}: hreflang mismatch")

  check(doc.css('main').size == 1 && doc.css('main h1').size == 1 && doc.css('main #about').size == 1, "#{code}: invalid landmarks")
  check(doc.at_css('main #about')['aria-labelledby'] == 'about-h' && doc.css('main #about h2#about-h').size == 1, "#{code}: about aria-labelledby mismatch")
  check(doc.css('meta[name=robots]').none? { |n| n['content'].include?('noindex') }, "#{code}: unexpected noindex")
  check(doc.css('meta[name=robots]').any? { |n| n['content'].include?('max-image-preview:large') }, "#{code}: missing max-image-preview:large")
  check(doc.css('details[data-language-picker] a[aria-current="page"]').size == 1, "#{code}: missing active language switcher item")

  scripts = doc.css('script[type="application/ld+json"]')
  check(scripts.size == 1, "#{code}: expected one structured-data graph")
  graph = JSON.parse(scripts.first.text).fetch('@graph')
  person = graph.find { |n| n['@type'] == 'Person' }
  website = graph.find { |n| n['@type'] == 'WebSite' }
  profile_page = graph.find { |n| n['@type'] == 'ProfilePage' }
  check(person && website && profile_page && website.fetch('author')['@id'] == person['@id'] && profile_page.dig('mainEntity', '@id') == person['@id'], "#{code}: disconnected identity graph")
  check(profile_page['inLanguage'] == tag && website['inLanguage'] == tag, "#{code}: JSON-LD inLanguage mismatch")
  check(person.fetch('knowsAbout').is_a?(Array) && !person['knowsAbout'].empty?, "#{code}: Person schema must include knowsAbout")
  check(person.fetch('sameAs').all? { |url| doc.css('a').any? { |a| a['href'] == url } }, "#{code}: schema profiles must match visible links")
  %w[https://www.linkedin.com/in/skzv https://github.com/skzv https://twitter.com/_skzv https://instagram.com/_skzv7].each do |url|
    link = doc.at_css("a[href='#{url}']")
    check(link && link['rel'].to_s.split.include?('me'), "#{code}: social link missing rel=me: #{url}")
  end
  check(doc.css('a[href="/red/"]').any? { |a| a['aria-hidden'] != 'true' }, "#{code}: must include an accessible crawlable link to /red/")
  check(html.index('<meta charset=') < 1024, "#{code}: charset must appear early")

  doc.css('script:not([src])').each do |script|
    next unless [nil, 'module', 'text/javascript'].include?(script['type'])
    _, error, status = Open3.capture3('node', '--check', '--input-type=module', stdin_data: script.text)
    check(status.success?, "#{code}: invalid generated JavaScript: #{error}")
  end
end

check(File.exist?(File.join(root, 'assets/img/preview-banner.png')), 'Missing preview')
check(File.size(File.join(root, 'favicon.ico')) < 32_768, 'favicon.ico is too large')
xml = Nokogiri::XML(File.read(File.join(root, 'sitemap.xml'))) { |config| config.strict }
check(xml.xpath('//*[local-name()="loc"]').map(&:text).sort == expected_sitemap.sort, "Unexpected sitemap URLs: #{xml.xpath('//*[local-name()="loc"]').map(&:text).sort.inspect}")
robots = File.read(File.join(root, 'robots.txt'))
check(robots.include?('User-agent: *') && robots.include?('Sitemap: https://skz.dev/sitemap.xml'), 'Invalid robots.txt')
not_found = Nokogiri::HTML(File.read(File.join(root, '404.html')))
check(not_found.css('meta[name=robots]').any? { |n| n['content'].include?('noindex') }, '404.html must include noindex')
%w[CLAUDE.md README.md LICENSE script sasha-kuznetsov-design-system].each do |path|
  check(!File.exist?(File.join(root, path)), "Development file published: #{path}")
end

# Red mode (/red/): indexable standalone 1-bit dithered canvas edition
home_doc = Nokogiri::HTML(File.read(File.join(root, 'index.html')))
home_graph = JSON.parse(home_doc.at_css('script[type="application/ld+json"]').text).fetch('@graph')
person = home_graph.find { |n| n['@type'] == 'Person' }
website = home_graph.find { |n| n['@type'] == 'WebSite' }

red = Nokogiri::HTML(File.read(File.join(root, 'red/index.html')))
check(red.css('title').size == 1 && red.at_css('title').text.start_with?('Sasha Kuznetsov'), 'Red: unexpected title')
%w[description og:title og:description og:url og:type og:image og:image:type og:image:width og:image:height og:image:alt twitter:card twitter:title twitter:description twitter:image twitter:image:alt].each do |key|
  nodes = red.css("meta[name='#{key}'], meta[property='#{key}']")
  check(nodes.size == 1 && !nodes.first['content'].empty?, "Red: missing or duplicate #{key}")
end
check(red.css('link[rel=canonical]').size == 1 && red.at_css('link[rel=canonical]')['href'] == 'https://skz.dev/red/', 'Red: canonical must be https://skz.dev/red/')
check(red.at_css("meta[property='og:url']")['content'] == 'https://skz.dev/red/', 'Red: og:url must be the red page')
check(red.at_css("meta[name='description']")['content'].length >= 100, 'Red: description too short for LinkedIn')
check(red.css('meta[name=robots]').none? { |n| n['content'].include?('noindex') }, 'Red: unexpected noindex')
check(red.css('meta[name=robots]').any? { |n| n['content'].include?('max-image-preview:large') }, 'Red: missing max-image-preview:large')
check(red.css('main').size == 1 && red.css('main h1').size == 1 && red.css('main #about').size == 1, 'Red: invalid landmarks')
red_image = red.at_css("meta[property='og:image']")['content']
check(red_image == red.at_css("meta[name='twitter:image']")['content'], 'Red: og:image and twitter:image differ')
check(red_image.start_with?('https://skz.dev/'), 'Red: preview image must be an absolute skz.dev URL')
red_image_path = File.join(root, red_image.delete_prefix('https://skz.dev/'))
check(File.exist?(red_image_path), 'Red: missing preview image')
check(File.binread(red_image_path, 8, 16).unpack('N2') == [1200, 630], 'Red: preview image must be 1200x630')
red_graph = JSON.parse(red.at_css('script[type="application/ld+json"]').text).fetch('@graph')
red_page = red_graph.find { |n| n['@type'] == 'WebPage' }
red_crumb = red_graph.find { |n| n['@type'] == 'BreadcrumbList' }
check(red_page && red_crumb && red_page.dig('isPartOf', '@id') == website['@id'] && red_page.dig('about', '@id') == person['@id'], 'Red: page is not connected to the identity graph')
check(person.fetch('sameAs').all? { |url| red.css('a').any? { |link| link['href'] == url } }, 'Red: profile links must match the home page')
_, red_js_err, red_js_status = Open3.capture3('node', '--check', File.join(root, 'red/js/dots.js'))
check(red_js_status.success?, "Red: invalid dots.js: #{red_js_err}")

puts "SEO and generated JavaScript checks passed (#{locales.size} languages + /red/)"
